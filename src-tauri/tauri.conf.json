{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ComfyShell",
  "version": "0.37.0",
  "identifier": "com.dsh.comfyshell",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ComfyShell",
        "width": 1360,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 720,
        "resizable": true,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}




































